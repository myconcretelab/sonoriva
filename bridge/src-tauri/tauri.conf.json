{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SonoRiva Bridge",
  "version": "1.0.6",
  "identifier": "fr.sonoriva.bridge",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "SonoRiva Bridge",
        "width": 560,
        "height": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:43821; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "./images/dmg-background.png",
        "windowSize": { "width": 768, "height": 512 },
        "appPosition": { "x": 170, "y": 150 },
        "applicationFolderPosition": { "x": 598, "y": 150 }
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["sonoriva-bridge"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0MkREMzlBMjhCNDE1QTIKUldTaUZiUW9tdE10dEF6RnlmL0xBTXVqVHdPT3hJdFBLZThnVjNjVUQxL1dVdjMrVFJFUTY5R2UK",
      "endpoints": [
        "https://github.com/myconcretelab/sonoriva/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
